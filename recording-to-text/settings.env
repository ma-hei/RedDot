# Settings without secrets (committed). Secrets such as OPENAI_API_KEY go in .env (ignored by git).
# Both are read at startup; real environment variables win, then .env, then this file.

# Google Cloud Speech-to-Text (docs/setup.md)
GOOGLE_PROJECT=your-speech-project
GOOGLE_LOCATION=us-central1

# Whisper through the OpenAI transcription API (recording_to_text/services/whisper.py). For your own
# GPU machine later: point WHISPER_BASE_URL at it, set WHISPER_MODEL and its key in .env.
# The key: OPENAI_API_KEY (or WHISPER_API_KEY) in .env.
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
